# ===== Required =====
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# Public URL of the site (used in LINE buttons, sitemap, canonical URLs)
APP_URL=https://boattripthailand.com
# Domain for Caddy HTTPS (same host as APP_URL)
DOMAIN=boattripthailand.com
# Optional: a second host that redirects to DOMAIN (www → main domain)
# REDIRECT_FROM=www.boattripthailand.com
# For running `npm run ...` outside Docker only (inside Docker this is set by docker-compose.yml)
DATABASE_URL=postgresql://btt:change-me@localhost:5432/btt

# Production server only: load the prod overrides (no public DB port, Caddy always on, log rotation)
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# ===== LINE OA (Messaging API) — lead alerts to sales =====
# LINE Developers console → your OA channel → Messaging API tab
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# Optional: fixed group id; otherwise invite the bot to the sales group and it is saved automatically
LINE_GROUP_ID=
# true = also post every lead to the group even when the assignee has LINE linked
LINE_ALWAYS_NOTIFY_GROUP=false
# Minutes before an un-contacted lead is escalated to the group
LEAD_SLA_MINUTES=15

# ===== Website buttons & tracking (baked in at build time) =====
NEXT_PUBLIC_WHATSAPP=66xxxxxxxxx
NEXT_PUBLIC_LINE_URL=https://lin.ee/xxxxxxx
NEXT_PUBLIC_CONTACT_EMAIL=boattripthailand@gmail.com
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ===== Meta Conversions API (server-side Lead / QualifiedLead / Converted) =====
META_PIXEL_ID=
META_CAPI_TOKEN=
# Use only while testing in Events Manager
META_TEST_EVENT_CODE=

# ===== Google Ads offline conversion CSV =====
GADS_CONVERSION_NAME=Charter booked

# ===== Google Analytics 4 + Search Console → /admin วิเคราะห์เว็บไซต์ (read-only, optional) =====
# Service account key (JSON file contents as one line of base64:  base64 -i key.json | tr -d '\n')
# Add the service account email as Viewer in GA4 and as a Restricted user in Search Console.
GOOGLE_SERVICE_ACCOUNT_JSON=
# GA4 → Admin → Property details → numeric Property ID (not the G-XXXX measurement id)
GA4_PROPERTY_ID=
# Search Console property: https://boattripthailand.com/  (URL-prefix)  or  sc-domain:boattripthailand.com
GSC_SITE_URL=https://boattripthailand.com/

# ===== Optional: PageSpeed Insights (SEO → Core Web Vitals card). Works without a key at a low shared quota =====
PAGESPEED_API_KEY=

# ===== Auto-translate in /admin — Gemini API free tier =====
# Key from https://aistudio.google.com/apikey on a Google Cloud project WITHOUT billing (free tier → never charged).
# Free-tier text may be used by Google to improve its products: only public website content is sent.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Caps checked before every request
# ceilings WE set (Gemini free = 500 requests/day; one request ≈ up to 6,000 characters)
TRANSLATE_MONTHLY_LIMIT=3000000
TRANSLATE_DAILY_REQUESTS=400
# false = switch the translate buttons off
TRANSLATE_ENABLED=true

# ===== Optional: Cloudflare Turnstile on the booking forms (free, no billing) =====
# Cloudflare dashboard → Turnstile → Add widget (hostname boattripthailand.com, mode Managed). Empty = forms use the other guards only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email (Resend · resend.com) — can also be set in /admin → ตั้งค่า → อีเมล & เอกสาร (the .env value wins)
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=contact@boattripthailand.com

# ===== Optional: security keys (defaults derive from POSTGRES_PASSWORD — set your own so changing the DB password does not reset them) =====
# Encrypts keys saved in /admin (LINE, Google, Resend). Changing it later means re-entering those keys.
# SETTINGS_KEY=a-long-random-string
# Signs the anti-spam token of the booking forms
# LEAD_TOKEN_SECRET=a-long-random-string

# ===== Optional: scheduler (backups, IndexNow, scheduled posts, alerts) =====
# Jobs run inside the app once a minute. true = switch them off (e.g. a second copy of the app).
# DISABLE_JOBS=false
# Lets a host cron / uptime monitor run the same tick: GET /api/cron?key=<CRON_SECRET>. Empty = /api/cron is off.
# CRON_SECRET=
# false = do not send new / changed / removed URLs to Bing & co. every 5 minutes
# INDEXNOW_AUTO=true

# ===== Optional: files & page cache =====
# Where uploads and the nightly backups (_backups/) are kept. Docker: the uploads volume, mounted at /app/uploads.
# UPLOAD_DIR=/app/uploads
# Rendered public pages: seconds before time-based text is refreshed (admin saves clear the cache anyway) and how many pages to keep
# SITE_CACHE_SECONDS=3600
# SITE_CACHE_PAGES=2000
# false = do not render every sitemap URL once after a start (the first visitors / crawlers then wait for cold pages)
# SSR_WARM=true

# ===== Optional: SEO switches =====
# 1 = noindex the whole site (staging / test servers). Leave empty on the live site. Hosts other than APP_URL are noindex anyway.
# SEO_NOINDEX=
# Daily caps for the free quotas used in /admin
# GEMINI_FREE_RPD=500
# PSI_DAILY_LIMIT=500
# Instead of GOOGLE_SERVICE_ACCOUNT_JSON: a path to the key file inside the container
# GOOGLE_APPLICATION_CREDENTIALS=

# ===== First admin account (scripts/create-user.ts: `npm run user:create`, or the flags --email --name) =====
# ADMIN_EMAIL=you@example.com
# ADMIN_NAME=ANAN

# Filled in automatically by the deploy (GitHub Actions → Docker build args) — shown in ตั้งค่า → ระบบ. Do not set by hand.
# APP_COMMIT= APP_COMMIT_TIME= APP_COMMIT_MSG= APP_BUILD_TIME= APP_REPO_URL=

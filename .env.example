# ===== Required =====
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# Public URL of the site (used in LINE buttons, sitemap, canonical URLs)
APP_URL=https://new.boattripthailand.com
# Domain for Caddy HTTPS (same host as APP_URL)
DOMAIN=new.boattripthailand.com
# Optional: a second host that redirects to DOMAIN, e.g. www.boattripthailand.com once the site moves to the main domain
# REDIRECT_FROM=
# For running `npm run ...` outside Docker only (inside Docker this is set by docker-compose.yml)
DATABASE_URL=postgresql://btt:change-me@localhost:5432/btt

# Production server only: load the prod overrides (no public DB port, Caddy always on, log rotation)
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# ===== LINE OA (Messaging API) — lead alerts to sales =====
# LINE Developers console → your OA channel → Messaging API tab
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# Optional: fixed group id; otherwise invite the bot to the sales group and it is saved automatically
LINE_GROUP_ID=
# true = also post every lead to the group even when the assignee has LINE linked
LINE_ALWAYS_NOTIFY_GROUP=false
# Minutes before an un-contacted lead is escalated to the group
LEAD_SLA_MINUTES=15

# ===== Website buttons & tracking (baked in at build time) =====
NEXT_PUBLIC_WHATSAPP=66xxxxxxxxx
NEXT_PUBLIC_LINE_URL=https://lin.ee/xxxxxxx
NEXT_PUBLIC_CONTACT_EMAIL=boattripthailand@gmail.com
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ===== Meta Conversions API (server-side Lead / QualifiedLead / Converted) =====
META_PIXEL_ID=
META_CAPI_TOKEN=
# Use only while testing in Events Manager
META_TEST_EVENT_CODE=

# ===== Google Ads offline conversion CSV =====
GADS_CONVERSION_NAME=Charter booked

# ===== Google Analytics 4 + Search Console → /admin วิเคราะห์เว็บไซต์ (read-only, optional) =====
# Service account key (JSON file contents as one line of base64:  base64 -i key.json | tr -d '\n')
# Add the service account email as Viewer in GA4 and as a Restricted user in Search Console.
GOOGLE_SERVICE_ACCOUNT_JSON=
# GA4 → Admin → Property details → numeric Property ID (not the G-XXXX measurement id)
GA4_PROPERTY_ID=
# Search Console property: https://boattripthailand.com/  (URL-prefix)  or  sc-domain:boattripthailand.com
GSC_SITE_URL=https://boattripthailand.com/

# ===== Optional: PageSpeed Insights (SEO → Core Web Vitals card). Works without a key at a low shared quota =====
PAGESPEED_API_KEY=

# ===== Auto-translate in /admin — Gemini API free tier =====
# Key from https://aistudio.google.com/apikey on a Google Cloud project WITHOUT billing (free tier → never charged).
# Free-tier text may be used by Google to improve its products: only public website content is sent.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Caps checked before every request
# ceilings WE set (Gemini free = 500 requests/day; one request ≈ up to 6,000 characters)
TRANSLATE_MONTHLY_LIMIT=3000000
TRANSLATE_DAILY_REQUESTS=400
# false = switch the translate buttons off
TRANSLATE_ENABLED=true

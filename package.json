{
  "name": "boattripthailand",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:site && npm run build:admin && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx scripts/seed.ts",
    "user:create": "tsx scripts/create-user.ts",
    "build:site": "tailwindcss -c tailwind.site.config.js -i site/tw-input.css -o public/site/tw.css --minify",
    "build:admin": "tailwindcss -c tailwind.admin.config.js -i site/tw-input.css -o public/admin-app/tw.css --minify"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "drizzle-orm": "0.45.3",
    "linkedom": "0.18.13",
    "next": "15.5.27",
    "otplib": "12.0.1",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tsx": "4.19.2",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.10.7",
    "@types/pg": "8.11.10",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "autoprefixer": "10.4.20",
    "drizzle-kit": "0.31.11",
    "postcss": "8.5.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3"
  }
}

# The site sits behind Cloudflare: take the visitor's IP from CF-Connecting-IP, but only when the request
# really comes from a Cloudflare edge (ranges from cloudflare.com/ips — update if Cloudflare adds new ones).
# Without this every visitor looks like a Cloudflare IP (shared login / lead rate limits, wrong IP in the audit log).
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32 {$TRUSTED_PROXIES}
		client_ip_headers CF-Connecting-IP
	}
}

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:3000 {
		# the app reads the first X-Forwarded-For entry: send exactly one, the real visitor
		header_up X-Forwarded-For {client_ip}
		header_up X-Real-IP {client_ip}
	}
}

# optional second host → DOMAIN (e.g. REDIRECT_FROM=www.boattripthailand.com after moving to the main domain).
# unset = a .localhost name, so Caddy never asks Let's Encrypt for a host that does not point here
{$REDIRECT_FROM:redirect.localhost} {
	redir https://{$DOMAIN}{uri} permanent
}
